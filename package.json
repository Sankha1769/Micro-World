{
  "name": "microverse",
  "version": "2.0.0",
  "private": true,
  "description": "MICROVERSE: an interactive 3D virtual microscope built with Three.js.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --unminified",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"styles/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"styles/*.css\" --fix",
    "test": "node tests/run-all.mjs",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
